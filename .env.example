# Copy to .env and fill in. Never commit .env.

# --- LLM (choose one provider) ---
# google_genai -> needs GOOGLE_API_KEY   (https://aistudio.google.com/apikey)
# openai       -> needs OPENAI_API_KEY
LLM_PROVIDER=google_genai
LLM_MODEL=gemini-3.6-flash
# Tried in order if the main model is busy or fails (same provider)
LLM_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite
GOOGLE_API_KEY=
OPENAI_API_KEY=

# --- Secrets (generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))") ---
JWT_SECRET=
POSTGRES_PASSWORD=

# --- Optional ---
# JWT_EXPIRE_MINUTES=720
# MIN_WORDS=50
# MAX_WORDS=2000
